# ---------------------------------------------------------------------------
# Harbor registry (air-gapped)
# Append to Makefile and add the targets to `make help`.
# Runtime is harbor_container_runtime in the inventory, not a make flag.
# HOST is checked here; ansible-automation's APB_FLAGS applies the limit.
# ---------------------------------------------------------------------------
STAGE_ARGS ?=

.PHONY: stage-harbor linux-registry verify-registry remove-registry
stage-harbor:
	ansible-playbook playbooks/linux/stage_harbor_artifacts.yml $(STAGE_ARGS)

linux-registry:
	@if [ -z "$(HOST)" ]; then echo "Usage: make linux-registry HOST=hostname"; exit 1; fi
	ansible-playbook $(APB_FLAGS) playbooks/linux/configure_registry.yml

verify-registry:
	@if [ -z "$(HOST)" ]; then echo "Usage: make verify-registry HOST=hostname"; exit 1; fi
	ansible-playbook $(APB_FLAGS) playbooks/linux/verify_registry.yml

remove-registry:
	@if [ -z "$(HOST)" ]; then echo "Usage: make remove-registry HOST=hostname"; exit 1; fi
	ansible-playbook $(APB_FLAGS) playbooks/linux/remove_registry.yml
