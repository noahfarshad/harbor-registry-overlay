---
# group_vars/registry/harbor_artifacts.yml
#
# Generated by stage_harbor_artifacts on the connected side. Copy this file into
# inventory/group_vars/registry/ in each environment. download_harbor_artifacts
# checks the installer against this checksum after it lands on the host.

harbor_version:           "{{ stage_harbor_version }}"
harbor_installer_file:    "{{ stage_harbor_installer_file }}"
harbor_installer_sha256:  "{{ stage_harbor_installer.stat.checksum }}"
